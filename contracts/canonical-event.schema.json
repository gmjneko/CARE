    "PendingInterrupt": {
      "description": "一个等待外部决策或恢复的挂起分支（Agent 节点内暂停、Workflow interrupt 或崩溃任务）。",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/definitions/InteractionRequestEvent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
