        "kind": {
          "enum": [
            "workflow_interrupt",
            "agent_interaction",
            "awaiting_input",
            "suspended",
            "failed",
            "aborted",
            "crashed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "node_id",
        "kind"
      ],
