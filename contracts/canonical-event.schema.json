            "$ref": "#/definitions/PendingInterrupt"
          },
          "title": "Interrupts",
          "type": "array"
        },
        "type": {
          "default": "workflow.interrupted",
          "enum": [
            "workflow.interrupted"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "WorkflowInterruptedEvent",
      "type": "object"
    },
    "WorkflowResumedEvent": {
      "description": "工作流从历史断点恢复执行时发射的起始事件。",
      "properties": {
        "resumed_from": {
          "enum": [
            "workflow_interrupt",
            "agent_interaction",
            "awaiting_input",
            "failure",
            "crash"
