  "$id": "https://care.local/contracts/canonical-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sequenced canonical event envelope emitted by WorkflowRunner.",
  "properties": {
    "node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Id"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "compaction": "#/$defs/CompactionEvent",
          "interaction.request": "#/$defs/InteractionRequestEvent",
          "message.completed": "#/$defs/MessageCompletedEvent",
          "node.completed": "#/$defs/NodeCompletedEvent",
          "node.started": "#/$defs/NodeStartedEvent",
          "retry": "#/$defs/RetryEvent",
          "text.delta": "#/$defs/TextDeltaEvent",
          "thinking.delta": "#/$defs/ThinkingDeltaEvent",
          "tool.completed": "#/$defs/ToolCompletedEvent",
          "tool.output_delta": "#/$defs/ToolOutputDeltaEvent",
          "tool.started": "#/$defs/ToolStartedEvent",
          "turn.completed": "#/$defs/TurnCompletedEvent",
          "turn.started": "#/$defs/TurnStartedEvent",
          "usage.updated": "#/$defs/UsageUpdatedEvent",
          "workflow.completed": "#/$defs/WorkflowCompletedEvent",
          "workflow.interrupted": "#/$defs/WorkflowInterruptedEvent",
          "workflow.resumed": "#/$defs/WorkflowResumedEvent",
          "workflow.started": "#/$defs/WorkflowStartedEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TurnStartedEvent"
        },
        {
          "$ref": "#/$defs/TextDeltaEvent"
        },
        {
          "$ref": "#/$defs/ThinkingDeltaEvent"
        },
        {
          "$ref": "#/$defs/MessageCompletedEvent"
        },
        {
          "$ref": "#/$defs/ToolStartedEvent"
        },
        {
          "$ref": "#/$defs/ToolOutputDeltaEvent"
        },
        {
          "$ref": "#/$defs/ToolCompletedEvent"
        },
        {
          "$ref": "#/$defs/CompactionEvent"
        },
        {
          "$ref": "#/$defs/RetryEvent"
        },
        {
          "$ref": "#/$defs/InteractionRequestEvent"
        },
        {
          "$ref": "#/$defs/UsageUpdatedEvent"
        },
        {
          "$ref": "#/$defs/TurnCompletedEvent"
        },
        {
          "$ref": "#/$defs/WorkflowStartedEvent"
        },
        {
          "$ref": "#/$defs/WorkflowResumedEvent"
        },
        {
          "$ref": "#/$defs/NodeStartedEvent"
        },
        {
          "$ref": "#/$defs/NodeCompletedEvent"
        },
        {
          "$ref": "#/$defs/WorkflowInterruptedEvent"
        },
        {
          "$ref": "#/$defs/WorkflowCompletedEvent"
        }
      ],
      "title": "Payload"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "title": "Seq",
      "type": "integer"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "run_id",
    "thread_id",
    "workflow_id",
    "payload"
  ],
  "title": "RuntimeEvent",
  "type": "object"
}
