      "type": "object"
    }
  },
  "description": "Sequenced canonical event envelope emitted by WorkflowRunner.",
  "properties": {
    "is_ephemeral": {
      "readOnly": true,
      "title": "Is Ephemeral",
      "type": "boolean"
    },
    "node_id": {
      "default": null,
      "title": "Node Id",
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "compaction": "#/definitions/CompactionEvent",
          "interaction.request": "#/definitions/InteractionRequestEvent",
          "message.completed": "#/definitions/MessageCompletedEvent",
          "node.completed": "#/definitions/NodeCompletedEvent",
          "node.started": "#/definitions/NodeStartedEvent",
          "retry": "#/definitions/RetryEvent",
          "runtime.error": "#/definitions/RuntimeErrorEvent",
          "text.delta": "#/definitions/TextDeltaEvent",
          "thinking.delta": "#/definitions/ThinkingDeltaEvent",
          "tool.completed": "#/definitions/ToolCompletedEvent",
          "tool.output_delta": "#/definitions/ToolOutputDeltaEvent",
          "tool.started": "#/definitions/ToolStartedEvent",
          "turn.completed": "#/definitions/TurnCompletedEvent",
          "turn.started": "#/definitions/TurnStartedEvent",
          "usage.updated": "#/definitions/UsageUpdatedEvent",
          "workflow.completed": "#/definitions/WorkflowCompletedEvent",
          "workflow.interrupted": "#/definitions/WorkflowInterruptedEvent",
          "workflow.resumed": "#/definitions/WorkflowResumedEvent",
          "workflow.started": "#/definitions/WorkflowStartedEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/TurnStartedEvent"
        },
        {
          "$ref": "#/definitions/TextDeltaEvent"
        },
        {
          "$ref": "#/definitions/ThinkingDeltaEvent"
        },
        {
          "$ref": "#/definitions/MessageCompletedEvent"
        },
        {
          "$ref": "#/definitions/ToolStartedEvent"
        },
        {
          "$ref": "#/definitions/ToolOutputDeltaEvent"
        },
        {
          "$ref": "#/definitions/ToolCompletedEvent"
        },
        {
          "$ref": "#/definitions/CompactionEvent"
        },
        {
          "$ref": "#/definitions/RetryEvent"
        },
        {
          "$ref": "#/definitions/InteractionRequestEvent"
        },
        {
          "$ref": "#/definitions/UsageUpdatedEvent"
        },
        {
          "$ref": "#/definitions/TurnCompletedEvent"
        },
        {
          "$ref": "#/definitions/WorkflowStartedEvent"
        },
        {
          "$ref": "#/definitions/WorkflowResumedEvent"
        },
        {
          "$ref": "#/definitions/NodeStartedEvent"
        },
        {
          "$ref": "#/definitions/NodeCompletedEvent"
        },
        {
          "$ref": "#/definitions/WorkflowInterruptedEvent"
        },
        {
          "$ref": "#/definitions/WorkflowCompletedEvent"
        },
        {
          "$ref": "#/definitions/RuntimeErrorEvent"
        }
      ],
      "title": "Payload"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "run_id",
    "thread_id",
    "workflow_id",
    "payload",
    "is_ephemeral"
  ],
  "title": "RuntimeEvent",
  "type": "object"
}
