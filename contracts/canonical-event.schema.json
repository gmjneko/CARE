        "code": {
          "default": null,
          "title": "Code",
          "type": [
            "string",
            "null"
          ]
        },
        "failure_class": {
          "enum": [
            "provider_error",
            "transport_error",
            "permission_error",
            "protocol_error",
            "usage_limit",
            "unknown"
          ],
          "title": "Failure Class",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "failure_class",
        "message"
      ],
      "title": "AgentFailure",
      "type": "object"
    },
